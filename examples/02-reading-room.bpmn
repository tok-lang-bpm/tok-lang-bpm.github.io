<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions" name="Reading room request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:process id="process" name="Reading room request" isExecutable="false">
    <bpmn:startEvent id="submitted" name="Request submitted" />
    <bpmn:userTask id="check" name="Check the reference code" />
    <bpmn:exclusiveGateway id="available" name="Are the records available?" />
    <bpmn:manualTask id="issue" name="Issue the records" />
    <bpmn:userTask id="inform" name="Inform the reader" />
    <bpmn:endEvent id="issued" name="Records issued" />
    <bpmn:endEvent id="informed" name="Reader informed" />
    <bpmn:sequenceFlow id="f-submitted-check" sourceRef="submitted" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-available" sourceRef="check" targetRef="available" />
    <bpmn:sequenceFlow id="f-available-issue" name="yes" sourceRef="available" targetRef="issue" />
    <bpmn:sequenceFlow id="f-available-inform" name="no" sourceRef="available" targetRef="inform" />
    <bpmn:sequenceFlow id="f-issue-issued" sourceRef="issue" targetRef="issued" />
    <bpmn:sequenceFlow id="f-inform-informed" sourceRef="inform" targetRef="informed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
