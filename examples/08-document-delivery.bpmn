        <bpmndi:BPMNLabel>
          <dc:Bounds x="384" y="325" width="12" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-fetch-digitise_di" bpmnElement="f-fetch-digitise">
