        <di:waypoint x="651" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-justified-inform_di" bpmnElement="f-justified-inform">
        <di:waypoint x="701" y="70" />
        <di:waypoint x="776" y="70" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="708" y="55" width="18" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-justified-restore_di" bpmnElement="f-justified-restore">
        <di:waypoint x="701" y="70" />
        <di:waypoint x="726" y="70" />
        <di:waypoint x="726" y="340" />
        <di:waypoint x="776" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="732" y="80" width="12" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-inform-remove_di" bpmnElement="f-inform-remove">
        <di:waypoint x="876" y="70" />
        <di:waypoint x="905" y="70" />
        <di:waypoint x="905" y="340" />
        <di:waypoint x="926" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-remove-merge_di" bpmnElement="f-remove-merge">
        <di:waypoint x="1026" y="340" />
        <di:waypoint x="1101" y="340" />
        <di:waypoint x="1101" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-restore-merge_di" bpmnElement="f-restore-merge">
        <di:waypoint x="876" y="340" />
        <di:waypoint x="901" y="340" />
        <di:waypoint x="901" y="70" />
        <di:waypoint x="1076" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-merge-reply_di" bpmnElement="f-merge-reply">
        <di:waypoint x="1126" y="70" />
        <di:waypoint x="1176" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-reply-closed_di" bpmnElement="f-reply-closed">
        <di:waypoint x="1276" y="70" />
        <di:waypoint x="1326" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-reminder-remind_di" bpmnElement="f-reminder-remind">
        <di:waypoint x="546" y="128" />
        <di:waypoint x="546" y="200" />
        <di:waypoint x="626" y="200" />
