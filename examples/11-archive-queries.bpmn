      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="refused_di" bpmnElement="refused">
        <dc:Bounds x="908" y="52" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="884" y="93" width="84" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="answer_di" bpmnElement="answer">
        <dc:Bounds x="1026" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="answered_di" bpmnElement="answered">
        <dc:Bounds x="1176" y="52" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1154" y="93" width="80" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="assess_di" bpmnElement="assess">
        <dc:Bounds x="326" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="is-complete_di" bpmnElement="is-complete" isMarkerVisible="true">
        <dc:Bounds x="476" y="185" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="461" y="159" width="80" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ask_di" bpmnElement="ask">
        <dc:Bounds x="576" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="details_di" bpmnElement="details">
        <dc:Bounds x="758" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="681" y="361" width="90" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="feasible_di" bpmnElement="feasible" isMarkerVisible="true">
        <dc:Bounds x="601" y="185" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="592" y="240" width="68" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="search_di" bpmnElement="search">
        <dc:Bounds x="726" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="write_di" bpmnElement="write">
        <dc:Bounds x="876" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f-arrived-register_di" bpmnElement="f-arrived-register">
        <di:waypoint x="126" y="70" />
        <di:waypoint x="176" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-register-assess_di" bpmnElement="f-register-assess">
        <di:waypoint x="276" y="70" />
        <di:waypoint x="376" y="70" />
        <di:waypoint x="376" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-assess-is-complete_di" bpmnElement="f-assess-is-complete">
        <di:waypoint x="426" y="210" />
        <di:waypoint x="476" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-is-complete-feasible_di" bpmnElement="f-is-complete-feasible">
