      <bpmndi:BPMNEdge id="f-search-write_di" bpmnElement="f-search-write">
        <di:waypoint x="826" y="210" />
        <di:waypoint x="876" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-write-answer_di" bpmnElement="f-write-answer">
        <di:waypoint x="976" y="210" />
        <di:waypoint x="1076" y="210" />
        <di:waypoint x="1076" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-answer-answered_di" bpmnElement="f-answer-answered">
        <di:waypoint x="1126" y="70" />
