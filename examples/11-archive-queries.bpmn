<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Archive queries: workload simulation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Details" name="Details" />
  <bpmn:resource id="archivists" name="Archivists" />
  <bpmn:resource id="clerks" name="Registry clerks" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="archive" name="State archive" processRef="archive-process" />
  </bpmn:collaboration>
  <bpmn:process id="archive-process" name="Archive queries: workload simulation" isExecutable="false">
    <bpmn:laneSet id="archive-lanes">
      <bpmn:lane id="registry" name="Registry">
        <bpmn:flowNodeRef>arrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="archivist" name="Archivist">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>is-complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feasible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="arrived" name="Query request received" />
    <bpmn:userTask id="register" name="Register the request">
      <bpmn:humanPerformer id="register-performer">
        <bpmn:resourceRef>clerks</bpmn:resourceRef>
      </bpmn:humanPerformer>
    </bpmn:userTask>
    <bpmn:sendTask id="refuse" name="Send a refusal">
      <bpmn:performer id="refuse-performer">
        <bpmn:resourceRef>clerks</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:sendTask>
    <bpmn:endEvent id="refused" name="Request refused" />
    <bpmn:sendTask id="answer" name="Send the answer">
      <bpmn:performer id="answer-performer">
        <bpmn:resourceRef>clerks</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:sendTask>
    <bpmn:endEvent id="answered" name="Query answered" />
    <bpmn:userTask id="assess" name="Assess the request">
      <bpmn:humanPerformer id="assess-performer">
        <bpmn:resourceRef>archivists</bpmn:resourceRef>
      </bpmn:humanPerformer>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="is-complete" name="Is the request complete?" default="f-is-complete-ask" />
    <bpmn:sendTask id="ask" name="Ask for missing details">
      <bpmn:performer id="ask-performer">
        <bpmn:resourceRef>archivists</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="details" name="Details received">
      <bpmn:messageEventDefinition id="details-def" messageRef="Message_Details" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="feasible" name="Is the query feasible?" />
    <bpmn:userTask id="search" name="Search the holdings">
      <bpmn:humanPerformer id="search-performer">
        <bpmn:resourceRef>archivists</bpmn:resourceRef>
      </bpmn:humanPerformer>
    </bpmn:userTask>
    <bpmn:userTask id="write" name="Write the answer">
      <bpmn:humanPerformer id="write-performer">
        <bpmn:resourceRef>archivists</bpmn:resourceRef>
      </bpmn:humanPerformer>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="f-arrived-register" sourceRef="arrived" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-assess" sourceRef="register" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-is-complete" sourceRef="assess" targetRef="is-complete" />
    <bpmn:sequenceFlow id="f-is-complete-feasible" name="yes" sourceRef="is-complete" targetRef="feasible">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">complete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-is-complete-ask" name="no" sourceRef="is-complete" targetRef="ask" />
    <bpmn:sequenceFlow id="f-ask-details" sourceRef="ask" targetRef="details" />
    <bpmn:sequenceFlow id="f-details-assess" sourceRef="details" targetRef="assess" />
    <bpmn:sequenceFlow id="f-feasible-search" name="yes" sourceRef="feasible" targetRef="search" />
    <bpmn:sequenceFlow id="f-feasible-refuse" name="no" sourceRef="feasible" targetRef="refuse" />
    <bpmn:sequenceFlow id="f-refuse-refused" sourceRef="refuse" targetRef="refused" />
    <bpmn:sequenceFlow id="f-search-write" sourceRef="search" targetRef="write" />
    <bpmn:sequenceFlow id="f-write-answer" sourceRef="write" targetRef="answer" />
    <bpmn:sequenceFlow id="f-answer-answered" sourceRef="answer" targetRef="answered" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="archive_di" bpmnElement="archive" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1250" height="410" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="registry_di" bpmnElement="registry" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="1220" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="archivist_di" bpmnElement="archivist" isHorizontal="true">
        <dc:Bounds x="30" y="140" width="1220" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="arrived_di" bpmnElement="arrived">
        <dc:Bounds x="90" y="52" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="71" y="93" width="74" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="register_di" bpmnElement="register">
