<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions" name="Archival search with a sub-process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Search_request" name="Search request" />
  <bpmn:message id="Message_Search_answer" name="Search answer" />
  <bpmn:message id="Message_Withdrawal" name="Withdrawal" />
  <bpmn:escalation id="Escalation_Difficult_search" name="Difficult search" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="archive" name="State archive" processRef="archive-process" />
    <bpmn:participant id="applicant" name="Applicant" />
    <bpmn:messageFlow id="m-applicant-request" name="Search request" sourceRef="applicant" targetRef="request" messageRef="Message_Search_request" />
    <bpmn:messageFlow id="m-answered-applicant" name="Search answer" sourceRef="answered" targetRef="applicant" messageRef="Message_Search_answer" />
    <bpmn:messageFlow id="m-applicant-withdrawn" name="Withdrawal" sourceRef="applicant" targetRef="withdrawn" messageRef="Message_Withdrawal" />
  </bpmn:collaboration>
  <bpmn:process id="archive-process" name="Archival search with a sub-process" isExecutable="false">
    <bpmn:laneSet id="archive-lanes">
      <bpmn:lane id="registry" name="Registry office">
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>in-scope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>out-of-scope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdrawal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="archivist" name="Archivist">
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>escalated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Head of department">
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decided</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="request" name="Search request received">
      <bpmn:messageEventDefinition id="request-def" messageRef="Message_Search_request" />
    </bpmn:startEvent>
    <bpmn:userTask id="register" name="Register the request" />
    <bpmn:exclusiveGateway id="in-scope" name="Does the request concern the holdings?" />
    <bpmn:endEvent id="out-of-scope" name="Request outside the holdings">
      <bpmn:terminateEventDefinition id="out-of-scope-def" />
    </bpmn:endEvent>
    <bpmn:subProcess id="withdrawal" name="Withdrawal of the request" triggeredByEvent="true">
      <bpmn:startEvent id="withdrawn" name="Request withdrawn">
        <bpmn:messageEventDefinition id="withdrawn-def" messageRef="Message_Withdrawal" />
      </bpmn:startEvent>
      <bpmn:userTask id="close" name="Close the case" />
      <bpmn:endEvent id="closed" name="Case closed" />
      <bpmn:sequenceFlow id="f-withdrawn-close" sourceRef="withdrawn" targetRef="close" />
      <bpmn:sequenceFlow id="f-close-closed" sourceRef="close" targetRef="closed" />
    </bpmn:subProcess>
    <bpmn:subProcess id="search" name="Search the holdings">
      <bpmn:startEvent id="search-start" />
      <bpmn:userTask id="finding-aids" name="Review the finding aids" />
      <bpmn:exclusiveGateway id="found" name="Were the records found?" />
      <bpmn:intermediateThrowEvent id="difficult" name="Head of department must decide">
        <bpmn:escalationEventDefinition id="difficult-def" escalationRef="Escalation_Difficult_search" />
      </bpmn:intermediateThrowEvent>
      <bpmn:userTask id="analyse" name="Analyse the records" />
      <bpmn:endEvent id="search-end" name="Search finished" />
      <bpmn:sequenceFlow id="f-search-start-finding-aids" sourceRef="search-start" targetRef="finding-aids" />
      <bpmn:sequenceFlow id="f-finding-aids-found" sourceRef="finding-aids" targetRef="found" />
      <bpmn:sequenceFlow id="f-found-analyse" name="yes" sourceRef="found" targetRef="analyse" />
      <bpmn:sequenceFlow id="f-found-difficult" name="no" sourceRef="found" targetRef="difficult" />
      <bpmn:sequenceFlow id="f-difficult-analyse" sourceRef="difficult" targetRef="analyse" />
      <bpmn:sequenceFlow id="f-analyse-search-end" sourceRef="analyse" targetRef="search-end" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="escalated" name="Difficult search" attachedToRef="search" cancelActivity="false">
      <bpmn:escalationEventDefinition id="escalated-def" escalationRef="Escalation_Difficult_search" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="answer" name="Prepare the answer" />
    <bpmn:endEvent id="answered" name="Answer sent">
      <bpmn:messageEventDefinition id="answered-def" messageRef="Message_Search_answer" />
    </bpmn:endEvent>
    <bpmn:userTask id="decide" name="Decide on further searching" />
    <bpmn:endEvent id="decided" name="Decision recorded" />
    <bpmn:sequenceFlow id="f-request-register" sourceRef="request" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-in-scope" sourceRef="register" targetRef="in-scope" />
    <bpmn:sequenceFlow id="f-in-scope-search" name="yes" sourceRef="in-scope" targetRef="search" />
    <bpmn:sequenceFlow id="f-in-scope-out-of-scope" name="no" sourceRef="in-scope" targetRef="out-of-scope" />
    <bpmn:sequenceFlow id="f-search-answer" sourceRef="search" targetRef="answer" />
    <bpmn:sequenceFlow id="f-answer-answered" sourceRef="answer" targetRef="answered" />
    <bpmn:sequenceFlow id="f-escalated-decide" sourceRef="escalated" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-decided" sourceRef="decide" targetRef="decided" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="archive_di" bpmnElement="archive" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1370" height="690" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="applicant_di" bpmnElement="applicant" isHorizontal="true">
        <dc:Bounds x="0" y="730" width="1370" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="registry_di" bpmnElement="registry" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="1340" height="340" />
