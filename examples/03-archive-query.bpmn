<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Archive query" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Answer" name="Answer" />
  <bpmn:process id="process" name="Archive query" isExecutable="false">
    <bpmn:startEvent id="arrived" name="Query received" />
    <bpmn:userTask id="assess" name="Assess the query" />
    <bpmn:exclusiveGateway id="complete" name="Is the query complete?" default="f-complete-ask" />
    <bpmn:userTask id="ask" name="Ask for missing details" />
    <bpmn:parallelGateway id="search" />
    <bpmn:userTask id="finding-aids" name="Search the finding aids" />
    <bpmn:userTask id="register" name="Search the query register" />
    <bpmn:parallelGateway id="results" />
    <bpmn:userTask id="answer" name="Draft the answer" />
    <bpmn:inclusiveGateway id="channel" name="How should the answer be sent?" default="f-channel-desk" />
    <bpmn:sendTask id="email" name="Send the answer by e-mail" messageRef="Message_Answer" />
    <bpmn:sendTask id="post" name="Send the answer by post" messageRef="Message_Answer" />
    <bpmn:manualTask id="desk" name="Hand the answer over at the desk" />
    <bpmn:inclusiveGateway id="delivered" />
    <bpmn:endEvent id="closed" name="Query closed" />
    <bpmn:sequenceFlow id="f-arrived-assess" sourceRef="arrived" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-complete" sourceRef="assess" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-search" name="yes" sourceRef="complete" targetRef="search">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">complete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-complete-ask" name="no" sourceRef="complete" targetRef="ask" />
    <bpmn:sequenceFlow id="f-ask-assess" sourceRef="ask" targetRef="assess" />
    <bpmn:sequenceFlow id="f-search-finding-aids" sourceRef="search" targetRef="finding-aids" />
    <bpmn:sequenceFlow id="f-finding-aids-results" sourceRef="finding-aids" targetRef="results" />
    <bpmn:sequenceFlow id="f-search-register" sourceRef="search" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-results" sourceRef="register" targetRef="results" />
    <bpmn:sequenceFlow id="f-results-answer" sourceRef="results" targetRef="answer" />
    <bpmn:sequenceFlow id="f-answer-channel" sourceRef="answer" targetRef="channel" />
    <bpmn:sequenceFlow id="f-channel-email" name="e-mail" sourceRef="channel" targetRef="email">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">email != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-channel-post" name="post" sourceRef="channel" targetRef="post">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">address != null and paper = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-channel-desk" name="in person" sourceRef="channel" targetRef="desk" />
    <bpmn:sequenceFlow id="f-email-delivered" sourceRef="email" targetRef="delivered" />
    <bpmn:sequenceFlow id="f-post-delivered" sourceRef="post" targetRef="delivered" />
    <bpmn:sequenceFlow id="f-desk-delivered" sourceRef="desk" targetRef="delivered" />
    <bpmn:sequenceFlow id="f-delivered-closed" sourceRef="delivered" targetRef="closed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process">
