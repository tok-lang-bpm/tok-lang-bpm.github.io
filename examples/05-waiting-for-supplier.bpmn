        <bpmndi:BPMNLabel>
          <dc:Bounds x="471" y="331" width="62" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reminder_di" bpmnElement="reminder">
