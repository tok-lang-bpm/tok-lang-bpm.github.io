<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Waiting for a supplier" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Order" name="Order" />
  <bpmn:message id="Message_Delivery" name="Delivery" />
  <bpmn:message id="Message_Refusal" name="Refusal" />
  <bpmn:signal id="Signal_Order_closed" name="Order closed" />
  <bpmn:process id="process" name="Waiting for a supplier" isExecutable="false">
    <bpmn:startEvent id="needed" name="Book needed" />
    <bpmn:sendTask id="order" name="Send the order" messageRef="Message_Order" />
    <bpmn:eventBasedGateway id="first" name="What happens first?" />
    <bpmn:intermediateCatchEvent id="delivered" name="Book delivered">
      <bpmn:messageEventDefinition id="delivered-def" messageRef="Message_Delivery" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="refused" name="Refusal received">
      <bpmn:messageEventDefinition id="refused-def" messageRef="Message_Refusal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timeout" name="14 days passed">
      <bpmn:timerEventDefinition id="timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="withdrawn" name="Title withdrawn by the publisher">
      <bpmn:conditionalEventDefinition id="withdrawn-def">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">status = "withdrawn"</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="receive-book" name="Receive the book" />
    <bpmn:endEvent id="done" name="Book received" />
    <bpmn:intermediateThrowEvent id="closed" name="Order closed">
      <bpmn:signalEventDefinition id="closed-def" signalRef="Signal_Order_closed" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="not-delivered" name="Order not fulfilled" />
    <bpmn:intermediateThrowEvent id="to-reminder" name="To reminder">
      <bpmn:linkEventDefinition id="to-reminder-def" name="Reminder" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="reminder" name="Reminder">
      <bpmn:linkEventDefinition id="reminder-def" name="Reminder" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="send-reminder" name="Send a reminder" />
    <bpmn:endEvent id="reminded" name="Reminder sent" />
    <bpmn:sequenceFlow id="f-needed-order" sourceRef="needed" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-first" sourceRef="order" targetRef="first" />
    <bpmn:sequenceFlow id="f-first-delivered" sourceRef="first" targetRef="delivered" />
    <bpmn:sequenceFlow id="f-first-refused" sourceRef="first" targetRef="refused" />
    <bpmn:sequenceFlow id="f-first-timeout" sourceRef="first" targetRef="timeout" />
    <bpmn:sequenceFlow id="f-first-withdrawn" sourceRef="first" targetRef="withdrawn" />
    <bpmn:sequenceFlow id="f-delivered-receive-book" sourceRef="delivered" targetRef="receive-book" />
    <bpmn:sequenceFlow id="f-receive-book-done" sourceRef="receive-book" targetRef="done" />
    <bpmn:sequenceFlow id="f-refused-closed" sourceRef="refused" targetRef="closed" />
    <bpmn:sequenceFlow id="f-closed-not-delivered" sourceRef="closed" targetRef="not-delivered" />
    <bpmn:sequenceFlow id="f-withdrawn-closed" sourceRef="withdrawn" targetRef="closed" />
    <bpmn:sequenceFlow id="f-timeout-to-reminder" sourceRef="timeout" targetRef="to-reminder" />
    <bpmn:sequenceFlow id="f-reminder-send-reminder" sourceRef="reminder" targetRef="send-reminder" />
    <bpmn:sequenceFlow id="f-send-reminder-reminded" sourceRef="send-reminder" targetRef="reminded" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process">
      <bpmndi:BPMNShape id="needed_di" bpmnElement="needed">
