        <bpmndi:BPMNLabel>
          <dc:Bounds x="468" y="223" width="68" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="not-delivered_di" bpmnElement="not-delivered">
