<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Monthly acquisitions report" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:process id="process" name="Monthly acquisitions report" isExecutable="false">
    <bpmn:startEvent id="month" name="First working day of the month">
      <bpmn:timerEventDefinition id="month-def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/2027-01-04T08:00/P1M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="figures" name="Collect the acquisition figures" />
    <bpmn:userTask id="draft" name="Write the report" />
    <bpmn:intermediateThrowEvent id="drafted" name="Report drafted" />
    <bpmn:userTask id="approve" name="Approve the report" />
    <bpmn:exclusiveGateway id="approved" name="Is the report approved?" default="f-approved-publish" />
    <bpmn:serviceTask id="publish" name="Publish the report on the intranet" />
    <bpmn:endEvent id="published" name="Report published" />
    <bpmn:endEvent id="withdrawn" name="Report withdrawn">
      <bpmn:terminateEventDefinition id="withdrawn-def" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f-month-figures" sourceRef="month" targetRef="figures" />
    <bpmn:sequenceFlow id="f-figures-draft" sourceRef="figures" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-drafted" sourceRef="draft" targetRef="drafted" />
    <bpmn:sequenceFlow id="f-drafted-approve" sourceRef="drafted" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-approved" sourceRef="approve" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-publish" name="yes" sourceRef="approved" targetRef="publish" />
    <bpmn:sequenceFlow id="f-approved-withdrawn" name="no" sourceRef="approved" targetRef="withdrawn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-publish-published" sourceRef="publish" targetRef="published" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process">
      <bpmndi:BPMNShape id="month_di" bpmnElement="month">
        <dc:Bounds x="30" y="52" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="0" y="93" width="96" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="figures_di" bpmnElement="figures">
        <dc:Bounds x="116" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="draft_di" bpmnElement="draft">
        <dc:Bounds x="266" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="drafted_di" bpmnElement="drafted">
        <dc:Bounds x="416" y="52" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="394" y="93" width="80" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve_di" bpmnElement="approve">
        <dc:Bounds x="502" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approved_di" bpmnElement="approved" isMarkerVisible="true">
        <dc:Bounds x="652" y="45" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="682" y="98" width="52" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="publish_di" bpmnElement="publish">
        <dc:Bounds x="752" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="published_di" bpmnElement="published">
        <dc:Bounds x="902" y="52" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="875" y="93" width="90" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="withdrawn_di" bpmnElement="withdrawn">
        <dc:Bounds x="784" y="160" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="757" y="201" width="90" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f-month-figures_di" bpmnElement="f-month-figures">
        <di:waypoint x="66" y="70" />
        <di:waypoint x="116" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-figures-draft_di" bpmnElement="f-figures-draft">
        <di:waypoint x="216" y="70" />
        <di:waypoint x="266" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-draft-drafted_di" bpmnElement="f-draft-drafted">
        <di:waypoint x="366" y="70" />
        <di:waypoint x="416" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-drafted-approve_di" bpmnElement="f-drafted-approve">
        <di:waypoint x="452" y="70" />
        <di:waypoint x="502" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-approve-approved_di" bpmnElement="f-approve-approved">
        <di:waypoint x="602" y="70" />
        <di:waypoint x="652" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-approved-publish_di" bpmnElement="f-approved-publish">
        <di:waypoint x="702" y="70" />
        <di:waypoint x="752" y="70" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="709" y="55" width="18" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-approved-withdrawn_di" bpmnElement="f-approved-withdrawn">
        <di:waypoint x="677" y="95" />
        <di:waypoint x="677" y="178" />
        <di:waypoint x="784" y="178" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="163" width="12" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-publish-published_di" bpmnElement="f-publish-published">
        <di:waypoint x="852" y="70" />
        <di:waypoint x="902" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
